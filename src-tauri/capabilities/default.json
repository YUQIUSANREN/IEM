{
  "identifier": "default",
  "description": "IEM 默认权限：本机数据库、用户选定的账单目录、系统通知。",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-download-read-recursive",
    "fs:allow-document-read-recursive",
    "fs:allow-desktop-read-recursive",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-watch",
    "dialog:default",
    "notification:default",
    "allow-drain-notify-queue",
    "allow-notification-listener-enabled",
    "allow-open-notification-listener-settings",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPCONFIG/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/Downloads/**" }
      ]
    }
  ]
}
